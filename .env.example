# Копируйте в .env и подставьте свои значения: `cp .env.example .env`
# Все переменные опциональны — по умолчанию приложение стартует как есть.

# postgresql://USER:PASSWORD@HOST:PORT/DBNAME (asyncpg-формат)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/melpops

# Уровень логирования: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Отладочный режим (пока не влияет на логику, но виден в логах старта)
DEBUG=false

# Метка окружения для health-отчёта: development | staging | production
ENVIRONMENT=development
